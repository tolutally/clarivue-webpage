{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/faq",
      "destination": "/faq.html"
    },
    {
      "source": "/getstarted",
      "destination": "/getstarted.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/support",
      "destination": "/support.html"
    },
    {
      "source": "/sitemap",
      "destination": "/sitemap.html"
    }
  ]
}
